# =============================================================================
#  FOTÔNIO — variáveis de ambiente
#  Copie para `.env.local` e preencha. O .env.local NÃO vai pro git.
#  NUNCA cole os valores reais em chat, issue, print ou commit.
# =============================================================================

# --- Cloudflare R2 (galerias online) ----------------------------------------
# Account ID aparece na URL do painel e no endpoint — não é segredo.
R2_ACCOUNT_ID=e9c4a117bdcb25c2c1974d2a526aff31
R2_BUCKET=galerias
# Estes dois vieram da tela "Create Account API token" (token `fotonio-app`).
# Cole aqui, direto do seu gerenciador de senhas:
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Banco (Postgres) --------------------------------------------------------
# Local: postgres://postgres:senha@localhost:5432/fotonio
# VPS:   postgres://usuario:senha@localhost:5432/fotonio
DATABASE_URL=

# --- Sessão ------------------------------------------------------------------
# Gere um valor aleatório: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Backblaze B2 (cofre) — só na fase 2 ------------------------------------
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=

# --- Asaas (cobrança) -------------------------------------------------------
# "sandbox" (padrão, não move dinheiro) ou "producao"
ASAAS_AMBIENTE=sandbox
ASAAS_API_KEY=
# Token que você inventa e cola também no painel do Asaas, na configuração do webhook
ASAAS_WEBHOOK_TOKEN=
# Carteiras que recebem o split do LUCRO (a reserva de custo fica na conta principal).
# Sócio sem carteira aqui simplesmente não recebe split — a parte dele fica na conta.
ASAAS_CARTEIRA_FELIPE=
ASAAS_CARTEIRA_CAROL=
ASAAS_CARTEIRA_SIRIUS=

# --- E-mail transacional (opcional) ------------------------------------------
# Sem estas duas, o "esqueci minha senha" fica ESCONDIDO: o link não aparece na
# tela de entrada e /recuperar avisa que o envio não está ligado, em vez de
# aceitar o e-mail e não mandar nada.
#
# O remetente precisa ser de um domínio verificado no Resend. Mandar "redefina
# sua senha do Galeria Átomo" de um endereço de outro domínio é exatamente o que um
# golpe faria.
RESEND_API_KEY=
EMAIL_REMETENTE=nao-responda@olumier.com.br

# --- Visão de administrador (opcional) ---------------------------------------
# E-mails que enxergam /painel/admin, separados por vírgula. VAZIA = ninguém.
# Não é coluna no banco de propósito: coluna pode ser ligada por engano, esta
# variável só muda com acesso ao servidor.
ADMINS=

# --- Servidor de ZIP (opcional) ---------------------------------------------
# Com as duas, todo ZIP é montado e entregue pelo servidor de ZIP, fora do VPS
# (docs/servidor-zip.md). Sem elas, o ZIP é montado aqui, como reserva.
# O segredo é o MESMO de /etc/fotonio-zip.env no servidor; 32+ caracteres.
ZIP_SERVIDOR_URL=
ZIP_SEGREDO=

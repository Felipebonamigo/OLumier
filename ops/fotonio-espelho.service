[Unit]
Description=Olumier - espelho dos arquivos (segunda copia no B2)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/fotonio
# --limite alto porque a passada e noturna e a banda do VPS e o teto real:
# o script para sozinho quando a fila acaba.
ExecStart=/usr/local/bin/node --env-file=/opt/fotonio/.env.production \
  --experimental-strip-types --import /opt/fotonio/scripts/registrar-ts.mjs \
  /opt/fotonio/scripts/espelhar.mjs --aplicar --limite=2000

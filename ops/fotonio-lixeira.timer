[Unit]
Description=Olumier - destruir galerias vencidas na lixeira

[Timer]
# 04:50 — depois do espelho (04:10) e do cofre (04:33). A ordem importa: o
# espelho precisa ter copiado o arquivo ANTES de a limpeza poder destrui-lo,
# senao uma galeria criada e apagada dentro da mesma janela sumiria sem nunca
# ter tido segunda copia.
OnCalendar=*-*-* 04:50:00
Persistent=true

[Install]
WantedBy=timers.target

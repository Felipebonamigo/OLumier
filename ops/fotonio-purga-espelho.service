[Unit]
Description=Olumier - varredura do espelho (remove copia de galeria ja destruida)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/fotonio
# Sem --exclusao, sempre: a rotina automatica so remove o que NAO tem mais
# linha no banco. Apagar copia de arquivo vivo e decisao humana, nunca de timer.
ExecStart=/usr/local/bin/node --env-file=/opt/fotonio/.env.production \
  --experimental-strip-types --import /opt/fotonio/scripts/registrar-ts.mjs \
  /opt/fotonio/scripts/purgar-espelho.mjs --aplicar
